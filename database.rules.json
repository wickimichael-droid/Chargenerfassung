{
  "rules": {
    ".read": false,
    ".write": false,
    "materialbahnhof": {
      "places": {
        ".read": "auth != null && auth.token.operator === true",
        "$place": {
          ".write": "auth != null && auth.token.operator === true",
          ".validate": "newData.hasChildren(['place','status','materialNumber','expectedCharge','actualCharge','updatedAt']) && newData.child('place').val() === $place && (newData.child('status').val() === 'ok' || newData.child('status').val() === 'error')"
        }
      },
      "articles": {
        ".read": "auth != null && auth.token.operator === true",
        "$number": {
          ".write": "auth != null && auth.token.operator === true && $number.matches(/^\\d{1,20}$/) && !data.exists()",
          ".validate": "newData.hasChildren(['bezeichnung']) && newData.child('bezeichnung').isString() && newData.child('bezeichnung').val().length > 0 && newData.child('bezeichnung').val().length <= 120"
        }
      },
      "history": {
        ".read": "auth != null && auth.token.operator === true",
        "$event": {
          ".write": "auth != null && auth.token.operator === true && ((!data.exists() && newData.exists() && newData.child('timestamp').isNumber() && newData.child('timestamp').val() <= now && newData.child('timestamp').val() > now - 60000) || (data.exists() && !newData.exists() && data.child('timestamp').val() < now - 1209600000))"
        }
      }
    }
  }
}
